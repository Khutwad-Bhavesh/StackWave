# RFID Library Cloud Architecture - Environment Variables (12-Factor)

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME=Cloud-Native RFID Library System

# Database Configuration (Postgres for Docker/AWS RDS, SQLite fallback for local test)
DATABASE_URL=sqlite:///./rfid_library.db
# For Docker Compose / RDS:
# DATABASE_URL=postgresql://rfid_admin:rfid_secure_pass@postgres:5432/rfid_library

# Database Container Defaults
POSTGRES_USER=rfid_admin
POSTGRES_PASSWORD=rfid_secure_pass
POSTGRES_DB=rfid_library

# Security & JWT Token Auth
JWT_SECRET_KEY=rfid-cloud-secret-token-key-2026-production-grade
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RFID Edge Ingestion & Cryptographic Verification
HMAC_REPLAY_WINDOW_SECONDS=60
RFID_DEBOUNCE_WINDOW_SECONDS=2.0
SESSION_TIMEOUT_SECONDS=90

# Circulation Business Rules
DEFAULT_LOAN_DAYS=14
MAX_BOOKS_PER_MEMBER=5
MAX_RENEWALS_PER_LOAN=1
FINE_PER_DAY=1.00
